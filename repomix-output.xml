                ) : (
                    <Text style={styles.buttonText}>Verify & Next</Text>
                )}
            </TouchableOpacity>

            <TouchableOpacity onPress={sendEmailOTP} style={styles.resendButton}>
                <Text style={styles.resendText}>Resend Email OTP</Text>
