                    <View style={styles.textContainer}>
                        <Text style={[styles.statusText, { color: textColor }]}>{statusText}</Text>
                        <Text style={[styles.scoreText, { color: textColor }]}>
                            RISK INDEX: {riskScore}/100
                        </Text>
                    </View>
                </View>
            </View>
        </LinearGradient>
    );
};

